{
  "permissions": {
    "allow": [
      "Bash(do sed -i 's/^module examples\\./module examples.chapter1./' \"$file\")",
      "Bash(do sed -i 's/^module exercises\\./module exercises.chapter1./' \"$file\")",
      "Bash(find:*)",
      "Bash(agda --safe:*)",
      "Bash(agda:*)",
      "Bash(grep:*)",
      "Bash(bash:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-agda.sh",
            "timeout": 120,
            "statusMessage": "Type-checking Agda..."
          }
        ]
      }
    ]
  }
}
